PORT=4000

# Database
# Example MySQL URL format:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/maqar

# Mobile (Expo exposes only EXPO_PUBLIC_* to the app)
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# Google Maps key for Android release builds only (Expo Go needs none). Keep it out of git.
GOOGLE_MAPS_API_KEY=
# Phone pushes (Expo push service). The Expo (EAS) project's id, and for Android builds the path
# to the Firebase project's google-services.json. Without them the app runs but gets no push token.
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=

# Auth (generate a long random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Sign-in and sign-up attempts per minute per IP
AUTH_RATE_LIMIT=10

# Uploaded photos, relative to apps/api. The dev API serves it at /uploads; nginx does in production.
UPLOADS_DIR=uploads

# Optional: Expo's push security token, if "enhanced push security" is on for the Expo project
EXPO_ACCESS_TOKEN=

# Password for the seeded demo accounts (pnpm --filter @maqar/api db:seed)
SEED_PASSWORD=change-me
