PORT=4000

# Database
# Example MySQL URL format:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/mqr

# Mobile (Expo exposes only EXPO_PUBLIC_* to the app)
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# Google Maps key for Android release builds only (Expo Go needs none). Keep it out of git.
GOOGLE_MAPS_API_KEY=
# Phone pushes on Android builds: the path to the Firebase project's google-services.json.
# (The Expo project's id is in apps/mobile/app.json.) Without it Android gets no push token.
GOOGLE_SERVICES_JSON=

# Auth (generate a long random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Sign-in and sign-up attempts per minute per IP
AUTH_RATE_LIMIT=10

# Uploaded photos, relative to apps/api. The dev API serves it at /uploads; nginx does in production.
UPLOADS_DIR=uploads

# Optional: Expo's push security token, if "enhanced push security" is on for the Expo project
EXPO_ACCESS_TOKEN=

# Optional: the mail server for password-reset codes. Gmail: smtp.gmail.com, 465, the address,
# and a Google app password. Without SMTP_HOST no email is sent (the dev API logs it instead).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Password for the seeded demo accounts (pnpm --filter @mqr/api db:seed)
SEED_PASSWORD=change-me
