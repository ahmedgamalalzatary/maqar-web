# Every variable the production server needs, in /root/maqar/.env.production (never in git).
# deploy/setup-server.sh generates the secrets on the server. NODE_ENV, PORT and TRUST_PROXY_HOPS
# are set in docker-compose.yml.

# MySQL container
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=maqar
MYSQL_USER=maqar
MYSQL_PASSWORD=

# API
DATABASE_URL=mysql://maqar:PASSWORD@mysql:3306/maqar
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
AUTH_RATE_LIMIT=10
UPLOADS_DIR=uploads

# Password for the seeded demo accounts. Test data only: remove them before a real release.
SEED_PASSWORD=
