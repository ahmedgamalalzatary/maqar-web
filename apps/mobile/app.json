{
  "expo": {
    "name": "Maqar",
    "slug": "maqar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-512.png",
    "scheme": "maqar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.maqar.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#041525",
        "foregroundImage": "./assets/brand/icon-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maqar.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041525",
          "image": "./assets/brand/logo-full.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
