{
  "expo": {
    "name": "Maqar",
    "slug": "maqar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-512.png",
    "scheme": "maqar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.maqar.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#041525",
        "foregroundImage": "./assets/brand/icon-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maqar.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041525",
          "image": "./assets/brand/logo-full.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#b38959",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Maqar uses your photos only when you choose some to send in a chat with your sales advisor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "dee8faab-c392-40ce-a1ab-2b3d5380c35a"
      }
    },
    "owner": "alzatary"
  }
}
