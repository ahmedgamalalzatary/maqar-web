{
  "expo": {
    "name": "Maqar",
    "slug": "maqar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-512.png",
    "scheme": "maqar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.maqar.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#041525",
        "foregroundImage": "./assets/brand/icon-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maqar.app",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041525",
          "image": "./assets/brand/logo-full.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#b38959",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Maqar uses your photos only when you choose some to send, in a chat or when adding photos to a listing or an area.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Maqar uses your phone’s motion only in a 360° tour, so you can look around a room by turning your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "dee8faab-c392-40ce-a1ab-2b3d5380c35a"
      }
    },
    "owner": "alzatary",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    }
  }
}
