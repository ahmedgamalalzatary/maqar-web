    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
