    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
