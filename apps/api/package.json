  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
